	"authors": [
		"ProFPS"
	],
	"contact": {
		"homepage": "https://fabricmc.net/"
	},
	"license": "CC0-1.0",
	"icon": "assets/profps/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.profps.client.ProFPSClient"
		]
	},
	"mixins": [
		{
			"config": "profps.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.2",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	}
